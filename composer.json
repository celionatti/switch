{
    "name": "switch/framework-workspace",
    "description": "Switch PHP Framework Workspace",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.3",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "switch/config": "*",
        "switch/console": "*",
        "switch/container": "*",
        "switch/controller": "*",
        "switch/database": "*",
        "switch/debugbar": "*",
        "switch/error-handler": "*",
        "switch/events": "*",
        "switch/foundation": "*",
        "switch/head": "*",
        "switch/http-message": "*",
        "switch/kernel": "*",
        "switch/live": "*",
        "switch/router": "*",
        "switch/session": "*",
        "switch/view": "*",
        "vlucas/phpdotenv": "5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Switch\\Container\\": "packages/container/src/",
            "Switch\\Http\\": "packages/http-message/src/",
            "Switch\\Router\\": "packages/router/src/",
            "Switch\\Event\\": "packages/events/src/",
            "Switch\\Config\\": "packages/config/src/",
            "Switch\\Kernel\\": "packages/kernel/src/",
            "Switch\\View\\": "packages/view/src/",
            "Switch\\Database\\": "packages/database/src/",
            "Switch\\DebugBar\\": "packages/debugbar/src/",
            "Switch\\ErrorHandler\\": "packages/error-handler/src/",
            "Switch\\Console\\": "packages/console/src/",
            "Switch\\Head\\": "packages/head/src/",
            "Switch\\Live\\": "packages/live/src/",
            "Switch\\Controller\\": "packages/controller/src/",
            "Switch\\Session\\": "packages/session/src/",
            "Switch\\Foundation\\": "packages/foundation/src/",
            "App\\": [
                "skeleton/app/",
                "sandbox/src/"
            ],
            "Switch\\Tests\\Integration\\": "tests/Integration/"
        },
        "files": [
            "packages/head/src/helpers.php",
            "packages/live/src/helpers.php",
            "packages/controller/src/helpers.php",
            "packages/session/src/helpers.php",
            "packages/foundation/src/helpers.php",
            "packages/debugbar/src/helpers.php"
        ]
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "config": {
        "sort-packages": true
    }
}
