{
    "name": "switch/framework-workspace",
    "description": "Switch PHP Framework Workspace",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "switch/container": "*",
        "switch/http-message": "*",
        "switch/router": "*",
        "switch/events": "*",
        "switch/config": "*",
        "switch/kernel": "*",
        "switch/view": "*",
        "switch/database": "*",
        "switch/error-handler": "*",
        "switch/console": "*",
        "switch/head": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Switch\\Container\\": "packages/container/src/",
            "Switch\\Http\\": "packages/http-message/src/",
            "Switch\\Router\\": "packages/router/src/",
            "Switch\\Event\\": "packages/events/src/",
            "Switch\\Config\\": "packages/config/src/",
            "Switch\\Kernel\\": "packages/kernel/src/",
            "Switch\\View\\": "packages/view/src/",
            "Switch\\Database\\": "packages/database/src/",
            "Switch\\ErrorHandler\\": "packages/error-handler/src/",
            "Switch\\Console\\": "packages/console/src/",
            "Switch\\Head\\": "packages/head/src/",
            "App\\": "sandbox/src/",
            "Switch\\Tests\\Integration\\": "tests/Integration/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "config": {
        "sort-packages": true
    }
}
