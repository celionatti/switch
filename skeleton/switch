#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Switch CLI — The futuristic PHP framework command-line tool.
 *
 * Usage:
 *   php switch                    Show all available commands
 *   php switch <command> [args]   Run a command
 *   php switch help <command>     Get help for a command
 */

define('SWITCH_START', microtime(true));

// Autoload Dependencies
require_once __DIR__ . '/vendor/autoload.php';

// Bootstrap Switch Application
$appKernel = require_once __DIR__ . '/bootstrap/app.php';

// Boot the Switch CLI Application
$app = new \Switch\Console\Application();
$app->discoverCommands();

$exitCode = $app->run();
exit($exitCode);
